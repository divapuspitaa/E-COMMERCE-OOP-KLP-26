<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="test.woi.controller.AdminDashboardController"
            minWidth="1050" minHeight="680">

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" spacing="0">
            <!-- Header Sidebar -->
            <VBox styleClass="sidebar-header" spacing="4" alignment="CENTER_LEFT">
                <Label text="🛍 AetherCart 26" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:white;"/>
                <Label text="Panel Penjual" style="-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.7);"/>
            </VBox>

            <!-- Admin Info -->
            <VBox alignment="CENTER" spacing="6" style="-fx-padding:20 16;-fx-border-color:rgba(255,255,255,0.08);-fx-border-width:0 0 1 0;">
                <Label text="🏪" style="-fx-font-size:36px;"/>
                <Label fx:id="lblAdminName" text="Penjual" style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:13px;"/>
                <Label text="Penjual" style="-fx-text-fill:rgba(255,255,255,0.5);-fx-font-size:10px;"/>
            </VBox>

            <!-- Navigation -->
            <VBox spacing="2" style="-fx-padding:10 0;">
                <Button text="📊  Dashboard" styleClass="sidebar-item, sidebar-item-active"
                        maxWidth="Infinity" onAction="#handleDashboard"/>
                <Button text="📦  Produk" styleClass="sidebar-item"
                        maxWidth="Infinity" onAction="#handleProducts"/>
                <Button text="🧾  Pesanan" styleClass="sidebar-item"
                        maxWidth="Infinity" onAction="#handleOrders"/>
                <Button text="👥  Pengguna" styleClass="sidebar-item"
                        maxWidth="Infinity" onAction="#handleUsers"/>
                <Button text="⚙️  Profil Saya" styleClass="sidebar-item" maxWidth="Infinity" onAction="#handleSellerProfile"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Logout -->
            <VBox style="-fx-padding:10 0 20 0;">
                <Button text="🚪  Keluar" styleClass="sidebar-item"
                        maxWidth="Infinity" onAction="#handleLogout"
                        style="-fx-text-fill:#E74C3C;"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="24" style="-fx-padding:28;">

                <!-- Page Header -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label text="Dashboard" style="-fx-font-size:24px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>
                        <Label fx:id="lblDate" text="-" style="-fx-font-size:12px;-fx-text-fill:#6C757D;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="🔄 Refresh" styleClass="btn-outline" onAction="#handleRefresh"/>
                </HBox>

                <!-- Stat Cards -->
                <HBox spacing="16">
                    <VBox styleClass="stat-card, stat-card-red" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="💰 Total Pendapatan" style="-fx-text-fill:rgba(255,255,255,0.85);-fx-font-size:12px;"/>
                        <Label fx:id="lblRevenue" text="Rp 0" style="-fx-text-fill:white;-fx-font-size:22px;-fx-font-weight:bold;"/>
                        <Label text="dari pesanan selesai" style="-fx-text-fill:rgba(255,255,255,0.6);-fx-font-size:10px;"/>
                    </VBox>
                    <VBox styleClass="stat-card, stat-card-blue" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="🧾 Total Pesanan" style="-fx-text-fill:rgba(255,255,255,0.85);-fx-font-size:12px;"/>
                        <Label fx:id="lblOrderCount" text="0" style="-fx-text-fill:white;-fx-font-size:22px;-fx-font-weight:bold;"/>
                        <Label text="semua waktu" style="-fx-text-fill:rgba(255,255,255,0.6);-fx-font-size:10px;"/>
                    </VBox>
                    <VBox styleClass="stat-card, stat-card-gold" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="📦 Total Produk" style="-fx-text-fill:rgba(255,255,255,0.85);-fx-font-size:12px;"/>
                        <Label fx:id="lblProductCount" text="0" style="-fx-text-fill:white;-fx-font-size:22px;-fx-font-weight:bold;"/>
                        <Label text="produk aktif" style="-fx-text-fill:rgba(255,255,255,0.6);-fx-font-size:10px;"/>
                    </VBox>
                    <VBox styleClass="stat-card, stat-card-green" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="👥 Total Pengguna" style="-fx-text-fill:rgba(255,255,255,0.85);-fx-font-size:12px;"/>
                        <Label fx:id="lblUserCount" text="0" style="-fx-text-fill:white;-fx-font-size:22px;-fx-font-weight:bold;"/>
                        <Label text="terdaftar" style="-fx-text-fill:rgba(255,255,255,0.6);-fx-font-size:10px;"/>
                    </VBox>
                </HBox>

                <!-- Recent Orders -->
                <VBox styleClass="card" spacing="14">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="🧾 Pesanan Terbaru" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Lihat Semua →" styleClass="btn-ghost"
                                style="-fx-text-fill:#C0392B;" onAction="#handleOrders"/>
                    </HBox>
                    <TableView fx:id="tableRecentOrders" prefHeight="240" style="-fx-background-radius:8;">
                        <columns>
                            <TableColumn fx:id="colOrderNum"    text="No. Pesanan"   prefWidth="180"/>
                            <TableColumn fx:id="colCustomer"    text="Pelanggan"      prefWidth="150"/>
                            <TableColumn fx:id="colTotal"       text="Total"          prefWidth="130"/>
                            <TableColumn fx:id="colStatus"      text="Status"         prefWidth="140"/>
                            <TableColumn fx:id="colOrderDate"   text="Tanggal"        prefWidth="140"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Quick Actions -->
                <VBox styleClass="card" spacing="14">
                    <Label text="⚡ Aksi Cepat" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>
                    <HBox spacing="12">
                        <Button text="➕ Tambah Produk"   styleClass="btn-primary"   onAction="#handleProducts"/>
                        <Button text="👥 Kelola Pengguna" styleClass="btn-secondary" onAction="#handleUsers"/>
                        <Button text="🧾 Kelola Pesanan"  styleClass="btn-outline"   onAction="#handleOrders"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
