<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="test.woi.controller.RegisterController"
           styleClass="auth-container"
           minWidth="900" minHeight="680">

    <VBox alignment="CENTER" spacing="0">
        <StackPane alignment="CENTER">
            <VBox styleClass="auth-card" spacing="20" maxWidth="480" alignment="CENTER">

                <Label text="🛍 AetherCart 26" styleClass="auth-logo"/>
                <Label text="Buat Akun Baru" style="-fx-font-size:18px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>

                <Label fx:id="lblError" text="" wrapText="true" maxWidth="440"
                       style="-fx-text-fill:#C0392B;-fx-font-size:12px;" visible="false" managed="false"/>

                <Label fx:id="lblSuccess" text="" wrapText="true" maxWidth="440"
                       style="-fx-text-fill:#27AE60;-fx-font-size:12px;" visible="false" managed="false"/>

                <!-- Pilih Role -->
                <VBox spacing="8" style="-fx-background-color:#F8F9FA;-fx-background-radius:10;-fx-padding:14;">
                    <Label text="Daftar sebagai:" style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <!-- Pembeli -->
                        <HBox spacing="8" alignment="CENTER_LEFT"
                              style="-fx-background-color:white;-fx-background-radius:8;-fx-padding:10 12;-fx-border-color:#DEE2E6;-fx-border-radius:8;"
                              HBox.hgrow="ALWAYS">
                            <RadioButton fx:id="rbCustomer" userData="CUSTOMER"/>
                            <VBox spacing="1">
                                <Label text="🛒 Pembeli" style="-fx-font-weight:bold;-fx-font-size:12px;"/>
                                <Label text="Belanja produk" style="-fx-font-size:10px;-fx-text-fill:#6C757D;"/>
                            </VBox>
                        </HBox>
                        <!-- Penjual -->
                        <HBox spacing="8" alignment="CENTER_LEFT"
                              style="-fx-background-color:white;-fx-background-radius:8;-fx-padding:10 12;-fx-border-color:#DEE2E6;-fx-border-radius:8;"
                              HBox.hgrow="ALWAYS">
                            <RadioButton fx:id="rbSeller" userData="SELLER"/>
                            <VBox spacing="1">
                                <Label text="🏪 Penjual" style="-fx-font-weight:bold;-fx-font-size:12px;"/>
                                <Label text="Jual produk" style="-fx-font-size:10px;-fx-text-fill:#6C757D;"/>
                            </VBox>
                        </HBox>
                        <!-- Admin -->
                        <HBox spacing="8" alignment="CENTER_LEFT"
                              style="-fx-background-color:white;-fx-background-radius:8;-fx-padding:10 12;-fx-border-color:#DEE2E6;-fx-border-radius:8;"
                              HBox.hgrow="ALWAYS">
                            <RadioButton fx:id="rbAdmin" userData="ADMIN"/>
                            <VBox spacing="1">
                                <Label text="🛡 Admin" style="-fx-font-weight:bold;-fx-font-size:12px;-fx-text-fill:#8B0000;"/>
                                <Label text="Kelola platform" style="-fx-font-size:10px;-fx-text-fill:#6C757D;"/>
                            </VBox>
                        </HBox>
                    </HBox>
                </VBox>

                <!-- Panel password admin (tersembunyi secara default) -->
                <VBox fx:id="vboxAdminPassword" spacing="4"
                      style="-fx-background-color:#FFF3CD;-fx-background-radius:8;-fx-padding:12;-fx-border-color:#FFEEBA;-fx-border-radius:8;"
                      visible="false" managed="false">
                    <Label text="🔒 Verifikasi Admin" style="-fx-font-weight:bold;-fx-font-size:12px;-fx-text-fill:#856404;"/>
                    <Label text="Masukkan password khusus admin untuk melanjutkan:"
                           style="-fx-font-size:11px;-fx-text-fill:#856404;" wrapText="true"/>
                    <PasswordField fx:id="txtAdminPassword" promptText="Password Admin"
                                  style="-fx-background-color:white;-fx-border-color:#FFEEBA;-fx-border-radius:6;-fx-background-radius:6;-fx-padding:8 12;"/>
                </VBox>

                <GridPane hgap="12" vgap="12" maxWidth="Infinity">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
                        <Label text="Nama Lengkap" styleClass="form-label"/>
                        <TextField fx:id="txtFullName" promptText="Nama lengkap Anda" styleClass="text-field" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Username *" styleClass="form-label"/>
                        <TextField fx:id="txtUsername" promptText="Min. 4 karakter" styleClass="text-field"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Email *" styleClass="form-label"/>
                        <TextField fx:id="txtEmail" promptText="email@contoh.com" styleClass="text-field"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Password *" styleClass="form-label"/>
                        <PasswordField fx:id="txtPassword" promptText="Min. 6 karakter" styleClass="password-field"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Konfirmasi Password *" styleClass="form-label"/>
                        <PasswordField fx:id="txtConfirmPassword" promptText="Ulangi password" styleClass="password-field"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <Label text="No. Telepon" styleClass="form-label"/>
                        <TextField fx:id="txtPhone" promptText="08xx..." styleClass="text-field"/>
                    </VBox>

                    <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2">
                        <Label text="Alamat" styleClass="form-label"/>
                        <TextArea fx:id="txtAddress" promptText="Alamat lengkap Anda"
                                  prefRowCount="2" maxWidth="Infinity"
                                  style="-fx-background-color:white;-fx-border-color:#DEE2E6;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:8 14;"/>
                    </VBox>
                </GridPane>

                <Button text="Daftar Sekarang" styleClass="btn-primary" maxWidth="Infinity"
                        onAction="#handleRegister"
                        style="-fx-font-size:14px;-fx-padding:12 24;" defaultButton="true"/>

                <HBox alignment="CENTER" spacing="6">
                    <Label text="Sudah punya akun?" styleClass="text-muted" style="-fx-font-size:13px;"/>
                    <Button text="Masuk" styleClass="btn-ghost" onAction="#handleGoLogin"
                            style="-fx-font-size:13px;-fx-text-fill:#C0392B;-fx-font-weight:bold;-fx-padding:0;-fx-background-color:transparent;-fx-cursor:hand;"/>
                </HBox>

            </VBox>
        </StackPane>
    </VBox>
</StackPane>
