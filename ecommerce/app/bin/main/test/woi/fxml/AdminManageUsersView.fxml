<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="test.woi.controller.AdminManageUsersController"
            minWidth="1100" minHeight="700">

    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-header" spacing="4">
                <Label text="🛍 AetherCart 26" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:white;"/>
                <Label text="Panel Admin" style="-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.7);"/>
            </VBox>

            <VBox alignment="CENTER" spacing="4" style="-fx-padding:16;-fx-border-color:rgba(255,255,255,0.08);-fx-border-width:0 0 1 0;">
                <Label text="🛡" style="-fx-font-size:30px;"/>
                <Label fx:id="lblMyInfo" text="-" style="-fx-text-fill:white;-fx-font-size:11px;-fx-font-weight:bold;" wrapText="true"/>
            </VBox>

            <VBox spacing="2" style="-fx-padding:10 0;">
                <Button text="📊  Dashboard"      styleClass="sidebar-item" maxWidth="Infinity" onAction="#handleDashboard"/>
                <Button text="🧾  Pesanan"        styleClass="sidebar-item" maxWidth="Infinity" onAction="#handleOrders"/>
                <Button text="👥  Pengguna"       styleClass="sidebar-item" maxWidth="Infinity" onAction="#handleUsers"/>
                <Button text="🛡  Kelola Akun"    styleClass="sidebar-item, sidebar-item-active" maxWidth="Infinity" onAction="#handleRefresh"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <VBox style="-fx-padding:10 0 20 0;">
                <Button text="🚪  Keluar" styleClass="sidebar-item" maxWidth="Infinity"
                        style="-fx-text-fill:#E74C3C;" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" style="-fx-padding:28;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label text="🛡 Kelola Akun Pengguna" style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#8B0000;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cmbFilter" promptText="Filter Role" style="-fx-pref-width:160;"/>
                <Button text="🔄 Refresh" styleClass="btn-outline" onAction="#handleRefresh"/>
            </HBox>

            <!-- Info box -->
            <HBox style="-fx-background-color:#FFF3CD;-fx-background-radius:8;-fx-padding:12 16;" spacing="8" alignment="CENTER_LEFT">
                <Label text="ℹ" style="-fx-font-size:16px;-fx-text-fill:#856404;"/>
                <Label wrapText="true" style="-fx-font-size:12px;-fx-text-fill:#856404;"
                       text="Admin dapat menonaktifkan atau menghapus akun Penjual dan Pembeli. Admin hanya bisa menghapus akun Admin yang lebih muda (ID lebih besar) dari akunnya sendiri."/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS" style="-fx-background-radius:12;">
                <columns>
                    <TableColumn fx:id="colSeq"      text="ID Admin" prefWidth="80"/>
                    <TableColumn fx:id="colName"     text="Nama"     prefWidth="170"/>
                    <TableColumn fx:id="colUsername" text="Username" prefWidth="130"/>
                    <TableColumn fx:id="colEmail"    text="Email"    prefWidth="180"/>
                    <TableColumn fx:id="colRole"     text="Role"     prefWidth="110"/>
                    <TableColumn fx:id="colStatus"   text="Status"   prefWidth="100"/>
                    <TableColumn fx:id="colActions"  text="Aksi"     prefWidth="210"/>
                </columns>
                <placeholder>
                    <Label text="Tidak ada pengguna." style="-fx-text-fill:#ADB5BD;"/>
                </placeholder>
            </TableView>

            <Label fx:id="lblCount" text="0 akun" style="-fx-font-size:12px;-fx-text-fill:#6C757D;"/>
        </VBox>
    </center>
</BorderPane>
