<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="test.woi.controller.OrderHistoryController"
            minWidth="900" minHeight="640">

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="16">
            <Label text="🛍 AetherCart 26" styleClass="navbar-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🏠 Beranda" styleClass="navbar-btn" onAction="#handleHome"/>
            <Button text="🛒 Keranjang" styleClass="navbar-btn" onAction="#handleCart"/>
            <Button text="👤 Profil" styleClass="navbar-btn" onAction="#handleProfile"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="0" style="-fx-padding:28;">
            <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-padding:0 0 20 0;">
                <Label text="📦 Riwayat Pesanan" style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cmbFilter" promptText="Filter Status" onAction="#handleFilter"
                          style="-fx-font-size:12px;-fx-pref-width:180;"/>
            </HBox>

            <Label fx:id="lblEmpty" text="📭 Belum ada pesanan. Yuk mulai belanja!"
                   style="-fx-font-size:14px;-fx-text-fill:#ADB5BD;" visible="false" managed="false"
                   style="-fx-padding:40 0;"/>

            <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                <VBox fx:id="orderList" spacing="16" style="-fx-padding:4;"/>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
