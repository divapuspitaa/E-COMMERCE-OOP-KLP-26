<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="test.woi.controller.CartController"
            minWidth="900" minHeight="600">

    <!-- NAVBAR -->
    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="16">
            <Label text="🛍 AetherCart 26" styleClass="navbar-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Lanjut Belanja" styleClass="navbar-btn" onAction="#handleContinue"/>
            <Button text="👤 Profil" styleClass="navbar-btn" onAction="#handleProfile"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="20" style="-fx-padding:24;" alignment="TOP_CENTER">

            <!-- Cart Items -->
            <VBox spacing="14" HBox.hgrow="ALWAYS">
                <Label text="🛒 Keranjang Belanja" style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>
                <Label fx:id="lblItemCount" text="0 item" style="-fx-font-size:13px;-fx-text-fill:#6C757D;"/>

                <ScrollPane fitToWidth="true" styleClass="scroll-pane" prefHeight="420" maxHeight="420">
                    <VBox fx:id="cartList" spacing="12" style="-fx-padding:4 4 4 0;"/>
                </ScrollPane>

                <Label fx:id="lblEmpty" text="🛒 Keranjang masih kosong. Yuk belanja dulu!"
                       style="-fx-font-size:14px;-fx-text-fill:#ADB5BD;" visible="false" managed="false"/>

                <Button text="🗑 Kosongkan Keranjang" styleClass="btn-ghost"
                        onAction="#handleClearCart"
                        style="-fx-text-fill:#C0392B;"/>
            </VBox>

            <!-- Order Summary -->
            <VBox spacing="14" minWidth="300" maxWidth="320" styleClass="cart-summary-box">
                <Label text="Ringkasan Pesanan" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>
                <Separator/>

                <HBox>
                    <Label text="Subtotal" style="-fx-text-fill:#495057;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSubtotal" text="Rp 0" style="-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>
                </HBox>
                <HBox>
                    <Label text="Estimasi Ongkir" style="-fx-text-fill:#495057;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblShipping" text="Rp 15.000" style="-fx-text-fill:#495057;"/>
                </HBox>
                <HBox>
                    <Label text="Diskon" style="-fx-text-fill:#27AE60;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDiscount" text="Rp 0" style="-fx-text-fill:#27AE60;"/>
                </HBox>

                <Separator/>

                <HBox>
                    <Label text="TOTAL" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotal" text="Rp 0" style="-fx-font-size:18px;-fx-font-weight:bold;-fx-text-fill:#C0392B;"/>
                </HBox>

                <VBox spacing="6" style="-fx-background-color:#FFF3CD;-fx-background-radius:8;-fx-padding:10;">
                    <Label text="ℹ Info Pengiriman:" style="-fx-font-size:11px;-fx-font-weight:bold;-fx-text-fill:#856404;"/>
                    <Label text="• Produk Digital: Gratis ongkir" style="-fx-font-size:11px;-fx-text-fill:#856404;"/>
                    <Label text="• Produk Fisik: Rp 15.000 flat" style="-fx-font-size:11px;-fx-text-fill:#856404;"/>
                </VBox>

                <Button text="Checkout Sekarang →" styleClass="btn-primary" maxWidth="Infinity"
                        onAction="#handleCheckout"
                        style="-fx-font-size:14px;-fx-padding:13 24;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
