<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.nusantarashop.controller.LoginController"
           styleClass="auth-container"
           minWidth="900" minHeight="600">

    <!-- Background Decoration -->
    <VBox alignment="CENTER" spacing="0">
        <StackPane alignment="CENTER">

            <!-- Decorative circles -->
            <Circle radius="200" fill="#FFFFFF" opacity="0.03" translateX="-300" translateY="-150"/>
            <Circle radius="150" fill="#FFFFFF" opacity="0.04" translateX="350" translateY="200"/>

            <!-- Auth Card -->
            <VBox styleClass="auth-card" spacing="24" maxWidth="420" alignment="CENTER">

                <!-- Logo -->
                <VBox alignment="CENTER" spacing="4">
                    <Label text="🛍 NusantaraShop" styleClass="auth-logo"/>
                    <Label text="Belanja produk lokal terbaik Indonesia" styleClass="auth-tagline"/>
                </VBox>

                <Separator/>

                <!-- Title -->
                <Label text="Masuk ke Akun Anda" style="-fx-font-size:18px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>

                <!-- Error Label -->
                <Label fx:id="lblError" text="" wrapText="true" maxWidth="360"
                       style="-fx-text-fill:#C0392B;-fx-font-size:12px;" visible="false" managed="false"/>

                <!-- Form -->
                <VBox spacing="14">
                    <VBox spacing="5">
                        <Label text="Username" styleClass="form-label"/>
                        <TextField fx:id="txtUsername" promptText="Masukkan username Anda" styleClass="text-field" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Password" styleClass="form-label"/>
                        <PasswordField fx:id="txtPassword" promptText="Masukkan password Anda" styleClass="password-field" maxWidth="Infinity"/>
                    </VBox>
                </VBox>

                <!-- Login Button -->
                <Button fx:id="btnLogin" text="Masuk" styleClass="btn-primary"
                        maxWidth="Infinity" onAction="#handleLogin"
                        defaultButton="true" style="-fx-font-size:14px;-fx-padding:12 24;"/>

                <!-- Demo Accounts Info -->
                <VBox alignment="CENTER" spacing="4">
                    <Label text="── Akun Demo ──" styleClass="divider-text"/>
                    <Label text="Admin: admin / admin123" style="-fx-font-size:11px;-fx-text-fill:#ADB5BD;"/>
                    <Label text="Pembeli: customer1 / cust123" style="-fx-font-size:11px;-fx-text-fill:#ADB5BD;"/>
                </VBox>

                <!-- Register Link -->
                <HBox alignment="CENTER" spacing="6">
                    <Label text="Belum punya akun?" styleClass="text-muted" style="-fx-font-size:13px;"/>
                    <Button fx:id="btnGoRegister" text="Daftar Sekarang" styleClass="btn-ghost"
                            onAction="#handleGoRegister"
                            style="-fx-font-size:13px;-fx-text-fill:#C0392B;-fx-font-weight:bold;-fx-padding:0;-fx-background-color:transparent;-fx-cursor:hand;"/>
                </HBox>

            </VBox>
        </StackPane>
    </VBox>
</StackPane>
