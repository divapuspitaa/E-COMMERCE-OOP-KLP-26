<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.nusantarashop.controller.AdminProductsController"
            minWidth="1050" minHeight="680">

    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-header" spacing="4">
                <Label text="🛍 NusantaraShop" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:white;"/>
                <Label text="Panel Admin" style="-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.7);"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding:10 0;">
                <Button text="📊  Dashboard" styleClass="sidebar-item" maxWidth="Infinity" onAction="#handleDashboard"/>
                <Button text="📦  Produk"    styleClass="sidebar-item, sidebar-item-active" maxWidth="Infinity"/>
                <Button text="🧾  Pesanan"   styleClass="sidebar-item" maxWidth="Infinity" onAction="#handleOrders"/>
                <Button text="👥  Pengguna"  styleClass="sidebar-item" maxWidth="Infinity" onAction="#handleUsers"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox style="-fx-padding:10 0 20 0;">
                <Button text="🚪  Keluar" styleClass="sidebar-item" maxWidth="Infinity"
                        style="-fx-text-fill:#E74C3C;" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding:28;">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label text="📦 Kelola Produk" style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtSearch" promptText="🔍 Cari produk..." styleClass="text-field"
                           style="-fx-pref-width:220;" onAction="#handleSearch"/>
                <Button text="Cari" styleClass="btn-outline" onAction="#handleSearch"/>
                <Button text="➕ Tambah Produk" styleClass="btn-primary" onAction="#handleAddProduct"/>
            </HBox>

            <!-- Table -->
            <TableView fx:id="tableProducts" VBox.vgrow="ALWAYS" style="-fx-background-radius:12;">
                <columns>
                    <TableColumn fx:id="colName"     text="Nama Produk"   prefWidth="220"/>
                    <TableColumn fx:id="colCategory" text="Kategori"       prefWidth="130"/>
                    <TableColumn fx:id="colType"     text="Tipe"           prefWidth="100"/>
                    <TableColumn fx:id="colPrice"    text="Harga"          prefWidth="120"/>
                    <TableColumn fx:id="colStock"    text="Stok"           prefWidth="70"/>
                    <TableColumn fx:id="colRating"   text="Rating"         prefWidth="80"/>
                    <TableColumn fx:id="colActive"   text="Status"         prefWidth="80"/>
                    <TableColumn fx:id="colActions"  text="Aksi"           prefWidth="130"/>
                </columns>
                <placeholder>
                    <Label text="Belum ada produk." style="-fx-text-fill:#ADB5BD;"/>
                </placeholder>
            </TableView>

            <Label fx:id="lblCount" text="0 produk" style="-fx-font-size:12px;-fx-text-fill:#6C757D;"/>
        </VBox>
    </center>
</BorderPane>
