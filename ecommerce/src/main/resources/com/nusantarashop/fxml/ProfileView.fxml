<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.nusantarashop.controller.ProfileController"
            minWidth="900" minHeight="640">

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="16">
            <Label text="🛍 NusantaraShop" styleClass="navbar-brand"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🏠 Beranda" styleClass="navbar-btn" onAction="#handleHome"/>
            <Button text="📦 Pesanan" styleClass="navbar-btn" onAction="#handleOrders"/>
            <Button text="🛒 Keranjang" styleClass="navbar-btn" onAction="#handleCart"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <HBox spacing="24" style="-fx-padding:28;" alignment="TOP_CENTER">

                <!-- LEFT: Avatar & Stats -->
                <VBox spacing="16" minWidth="260" maxWidth="280">
                    <!-- Profile Card -->
                    <VBox styleClass="card" spacing="14" alignment="CENTER">
                        <Label fx:id="lblAvatar" text="👤" style="-fx-font-size:64px;"/>
                        <VBox alignment="CENTER" spacing="4">
                            <Label fx:id="lblName" text="-" style="-fx-font-size:18px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>
                            <Label fx:id="lblRole" text="-" style="-fx-font-size:12px;-fx-text-fill:#6C757D;"/>
                            <Label fx:id="lblUsername" text="-" style="-fx-font-size:12px;-fx-text-fill:#ADB5BD;"/>
                        </VBox>
                    </VBox>

                    <!-- Saldo Card -->
                    <VBox styleClass="stat-card, stat-card-green" spacing="6" alignment="CENTER">
                        <Label text="💰 Saldo Anda" style="-fx-text-fill:white;-fx-font-size:12px;"/>
                        <Label fx:id="lblBalance" text="Rp 0" style="-fx-text-fill:white;-fx-font-size:22px;-fx-font-weight:bold;"/>
                        <Button text="+ Top Up Saldo" styleClass="btn-ghost"
                                style="-fx-text-fill:white;-fx-border-color:white;-fx-border-radius:8;-fx-background-radius:8;-fx-border-width:1;"
                                onAction="#handleTopUp"/>
                    </VBox>

                    <!-- Quick Stats -->
                    <VBox styleClass="card" spacing="10">
                        <Label text="Statistik Belanja" style="-fx-font-weight:bold;-fx-font-size:13px;-fx-text-fill:#1A1A2E;"/>
                        <HBox>
                            <Label text="Total Pesanan" style="-fx-text-fill:#6C757D;-fx-font-size:12px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblOrderCount" text="0" style="-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>
                        </HBox>
                        <HBox>
                            <Label text="Pesanan Selesai" style="-fx-text-fill:#6C757D;-fx-font-size:12px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblDoneCount" text="0" style="-fx-font-weight:bold;-fx-text-fill:#27AE60;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- RIGHT: Edit Form -->
                <VBox spacing="20" HBox.hgrow="ALWAYS" maxWidth="540">
                    <Label text="✏️ Edit Profil" style="-fx-font-size:20px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>

                    <Label fx:id="lblMsg" text="" wrapText="true" maxWidth="500"
                           style="-fx-font-size:12px;" visible="false" managed="false"/>

                    <VBox styleClass="card" spacing="14">
                        <GridPane hgap="14" vgap="14">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Nama Lengkap" styleClass="form-label"/>
                                <TextField fx:id="txtFullName" styleClass="text-field" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Email" styleClass="form-label"/>
                                <TextField fx:id="txtEmail" styleClass="text-field" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="No. Telepon" styleClass="form-label"/>
                                <TextField fx:id="txtPhone" styleClass="text-field" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Username" styleClass="form-label"/>
                                <TextField fx:id="txtUsernameDisp" styleClass="text-field" editable="false"
                                           style="-fx-background-color:#F8F9FA;" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                                <Label text="Alamat" styleClass="form-label"/>
                                <TextArea fx:id="txtAddress" prefRowCount="3" maxWidth="Infinity"
                                          style="-fx-background-color:white;-fx-border-color:#DEE2E6;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:10 14;-fx-font-size:13px;"/>
                            </VBox>
                        </GridPane>

                        <Button text="💾 Simpan Perubahan" styleClass="btn-primary"
                                onAction="#handleSave" style="-fx-padding:10 28;"/>
                    </VBox>

                    <!-- Change Password -->
                    <VBox styleClass="card" spacing="14">
                        <Label text="🔒 Ubah Password" style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>

                        <Label fx:id="lblPwdMsg" text="" wrapText="true" maxWidth="500"
                               style="-fx-font-size:12px;" visible="false" managed="false"/>

                        <HBox spacing="14">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Password Baru" styleClass="form-label"/>
                                <PasswordField fx:id="txtNewPwd" styleClass="password-field" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Konfirmasi Password" styleClass="form-label"/>
                                <PasswordField fx:id="txtConfirmPwd" styleClass="password-field" maxWidth="Infinity"/>
                            </VBox>
                        </HBox>
                        <Button text="🔑 Ubah Password" styleClass="btn-outline"
                                onAction="#handleChangePwd" style="-fx-padding:9 24;"/>
                    </VBox>

                    <!-- Logout -->
                    <Button text="🚪 Keluar dari Akun" styleClass="btn-danger"
                            onAction="#handleLogout" style="-fx-padding:10 24;"/>
                </VBox>

            </HBox>
        </ScrollPane>
    </center>
</BorderPane>
