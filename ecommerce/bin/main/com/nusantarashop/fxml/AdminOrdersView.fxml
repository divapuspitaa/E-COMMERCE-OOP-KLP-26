<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.nusantarashop.controller.AdminOrdersController"
            minWidth="1050" minHeight="680">

    <left>
        <VBox styleClass="sidebar" spacing="0">
            <VBox styleClass="sidebar-header" spacing="4">
                <Label text="🛍 NusantaraShop" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:white;"/>
                <Label text="Panel Admin" style="-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.7);"/>
            </VBox>
            <VBox spacing="2" style="-fx-padding:10 0;">
                <Button text="📊  Dashboard" styleClass="sidebar-item" maxWidth="Infinity" onAction="#handleDashboard"/>
                <Button text="📦  Produk"    styleClass="sidebar-item" maxWidth="Infinity" onAction="#handleProducts"/>
                <Button text="🧾  Pesanan"   styleClass="sidebar-item, sidebar-item-active" maxWidth="Infinity"/>
                <Button text="👥  Pengguna"  styleClass="sidebar-item" maxWidth="Infinity" onAction="#handleUsers"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox style="-fx-padding:10 0 20 0;">
                <Button text="🚪  Keluar" styleClass="sidebar-item" maxWidth="Infinity"
                        style="-fx-text-fill:#E74C3C;" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-padding:28;">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label text="🧾 Kelola Pesanan" style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#1A1A2E;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cmbFilter" promptText="Filter Status" onAction="#handleFilter"
                          style="-fx-font-size:12px;-fx-pref-width:180;"/>
                <Button text="🔄 Refresh" styleClass="btn-outline" onAction="#handleRefresh"/>
            </HBox>

            <TableView fx:id="tableOrders" VBox.vgrow="ALWAYS" style="-fx-background-radius:12;">
                <columns>
                    <TableColumn fx:id="colOrderNum"   text="No. Pesanan"    prefWidth="190"/>
                    <TableColumn fx:id="colCustomer"   text="Pelanggan"       prefWidth="140"/>
                    <TableColumn fx:id="colTotal"      text="Total"           prefWidth="120"/>
                    <TableColumn fx:id="colPayment"    text="Pembayaran"      prefWidth="110"/>
                    <TableColumn fx:id="colStatus"     text="Status"          prefWidth="150"/>
                    <TableColumn fx:id="colDate"       text="Tanggal"         prefWidth="130"/>
                    <TableColumn fx:id="colAction"     text="Ubah Status"     prefWidth="140"/>
                </columns>
                <placeholder><Label text="Belum ada pesanan." style="-fx-text-fill:#ADB5BD;"/></placeholder>
            </TableView>

            <Label fx:id="lblCount" text="0 pesanan" style="-fx-font-size:12px;-fx-text-fill:#6C757D;"/>
        </VBox>
    </center>
</BorderPane>
